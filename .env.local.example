# -----------------------------------------------------------------------------
# Auth.js (next-auth v5) + Microsoft Entra ID (Azure AD)
# Copy this file to `.env.local` and fill in the values.
# For Vercel: add the same variables (names WITHOUT the trailing example values)
# to your Vercel project under Settings > Environment Variables.
# -----------------------------------------------------------------------------

# Secret used by Auth.js to encrypt the JWT session cookie and CSRF tokens.
# REQUIRED. Generate one with:  npx auth secret
AUTH_SECRET=

# App (client) ID of your Microsoft Entra ID application registration.
AUTH_MICROSOFT_ENTRA_ID_ID=

# Client secret (password) from "Certificates & secrets" in the app registration.
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Issuer URL of the authority you want to authenticate against.
#
# Choose based on who signs in:
#
#   Personal Microsoft accounts only:
#     https://login.microsoftonline.com/consumers/v2.0
#
#   Work / school accounts of a specific tenant (recommended for internal apps):
#     https://login.microsoftonline.com/<your-tenant-id>/v2.0
#
#   Any Microsoft identity (personal + work/school, multi-tenant):
#     https://login.microsoftonline.com/common/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Optional: when you deploy on Vercel, the same values go in the Vercel project
# env (AUTH_URL is set automatically by Vercel for production; for preview
# deployments set AUTH_URL to the preview URL, e.g. https://<alias>.vercel.app).
# AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# SEO
# Canonical public URL of the site, used by sitemap.xml, robots.txt and
# structured data. No trailing slash. Defaults to https://boutsoque.vercel.app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://boutsoque.vercel.app